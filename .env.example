NODE_ENV=development
PORT=3015
HOST=0.0.0.0
# MongoDB compartido existente: admite standalone o replica set, sin reconfigurar el servicio.
MONGODB_URI=mongodb://127.0.0.1:27017/registro_visitas?directConnection=true
# Solo Docker: URI accesible desde el contenedor; vacío usa host.docker.internal:27017.
DOCKER_MONGODB_URI=
# Solo para la utilidad legada de instancia aislada, si se configura explícitamente el puerto 27019.
MONGOD_PATH=
# Generar una clave distinta en cada entorno; nunca versionar su valor real.
JWT_SECRET=
JWT_ISSUER=registro-visitas
JWT_AUDIENCE=registro-visitas-api
JWT_EXPIRES_IN=8h
# local | wms | both. WMS debe asociarse a usuarios locales mediante wmsId.
AUTH_MODE=local
WMS_JWT_SECRET=
WMS_JWT_SUBJECT_CLAIM=id_usuario
WMS_AUTO_PROVISION=false
WMS_API_URL=http://127.0.0.1:3000/api
WMS_JWT_ISSUER=
WMS_JWT_AUDIENCE=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=0
# S3/MinIO, igual que GestorDocumental. Sin almacenamiento local de fotos.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=registro-de-visitas
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=registro-visitas
MAX_UPLOAD_MB=5
# Una carga completa a la vez, desde recepción del archivo hasta finalizar S3.
PHOTO_MAX_CONCURRENT=1
PHOTO_FACE_MAX_PX=720
PHOTO_DOCUMENT_MAX_PX=1440
PHOTO_FACE_QUALITY=60
PHOTO_DOCUMENT_QUALITY=72
PHOTO_MAX_OUTPUT_KB=256
# Es una propuesta operativa configurable, no un plazo impuesto por ley.
PHOTO_RETENTION_DAYS=90
PRIVACY_RESPONSIBLE=Fastwaysas
PRIVACY_CONTACT=https://www.fastwaysas.com/contacto | Tel. +57 314 300 2760
APPOINTMENT_EARLY_MINUTES=30
APPOINTMENT_LATE_MINUTES=30
# Solo para bootstrap:admin. No hay administrador ni contraseña por defecto.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
